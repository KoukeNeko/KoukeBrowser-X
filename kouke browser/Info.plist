<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Kouke Browser URL Scheme</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kouke</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
		<!-- Declaring http and https is what registers the app with macOS as a
		     browser: without it the app cannot be chosen as the default browser,
		     and Apple's Web Browser Public Key Credential entitlement lists it as
		     the first requirement. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>Web Site URL</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
	</array>
</dict>
</plist>
