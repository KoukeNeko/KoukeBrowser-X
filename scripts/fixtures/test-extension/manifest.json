{
  "manifest_version": 3,
  "name": "Kouke Spike Probe",
  "version": "1.0.0",
  "description": "Phase 0 spike probe. Exercises the same extension mechanisms a password manager relies on.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kouke Spike Probe"
  }
}
